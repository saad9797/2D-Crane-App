# --- Database -------------------------------------------------------------
# Local Postgres from docker-compose.yml (or `npm run db:embedded` if you have no Docker).
DATABASE_URL="postgresql://crane:crane@localhost:5433/crane"
DIRECT_URL="postgresql://crane:crane@localhost:5433/crane"
# Neon: DATABASE_URL = POOLED string (host has "-pooler"), DIRECT_URL = DIRECT string. Both need ?sslmode=require

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API (no trailing slash)
CORS_ORIGINS="http://localhost:5173"
# Number of reverse proxies in front of the API (Render = 1); controls req.ip for rate limiting
TRUST_PROXY=0
LOG_LEVEL=info

# --- Auth -----------------------------------------------------------------
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-secret-change-me-dev-only-secret-change-me"
JWT_EXPIRES_IN=12h
BCRYPT_COST=12
